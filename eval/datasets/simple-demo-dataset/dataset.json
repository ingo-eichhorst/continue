{
  "name": "simple-demo-dataset",
  "description": "A simple demonstration dataset for basic LLM question-answer evaluation",
  "version": "0.0.1",
  "testCases": [
    {
      "id": "greeting-test",
      "name": "Basic Greeting Test",
      "description": "Tests if the LLM can respond to a simple greeting",
      "input": {
        "prompt": "Hello! How are you today?"
      },
      "expected": {
        "output": "hello"
      },
      "metadata": {
        "difficulty": "easy"
      }
    },
    {
      "id": "math-simple",
      "name": "Simple Math Question",
      "description": "Tests basic arithmetic capabilities",
      "input": {
        "prompt": "What is 2 + 2?"
      },
      "expected": {
        "output": "4"
      },
      "metadata": {
        "difficulty": "easy"
      }
    }
  ]
}
